# Copie para .env e ajuste. Nunca faça commit do .env.
# --- AsianOdds (login do site) ---
AO_USER=
AO_PASS=
AO_BOOKIE=PIN
AO_HEADLESS=false
# --- stats do intervalo (aposte.me), as mesmas do bot365_blogabet ---
APOSTEME_LICENCA=
APOSTEME_USUARIO=
# MODELO_ONNX=/caminho/para/model.onnx   (padrão: bot/model.onnx)
# --- estratégia ---
SIMULACAO=true
MINIMO_INDICE=0.12
PERCENTUAL_DE_KELLY=0.4
MAXIMO_DA_BANCA_POR_APOSTA=0.1
ODDS_MINIMA=1.825
MAX_DESEQUILIBRIO_ODDS=0.075
MAX_IDADE_STATS_MIN=6
INTERVALO_SEG=30
JARO_MINIMO=0.9
MAX_MINUTO_AO=55
# --- dinheiro ---
BANCA=0
EXPOSICAO_MAX_DIA=0
